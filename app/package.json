{
  "name": "studio-legale-introcaso",
  "version": "1.5.1",
  "description": "Gestione locale dello Studio Legale Introcaso con assistente GPT integrato",
  "main": "electron/main.cjs",
  "author": "Studio Legale Introcaso",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "34.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "it.studiolegaleintrocaso.desktop",
    "productName": "Studio Legale Introcaso",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Studio-Legale-Introcaso-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/@napi-rs/canvas/**"
    ]
  },
  "dependencies": {
    "mammoth": "1.9.1",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "4.10.38",
    "@napi-rs/canvas": "0.1.68",
    "tesseract.js": "6.0.1"
  }
}
